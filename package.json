{
  "name": "misteralg",
  "version": "1.6.1",
  "private": true,
  "description": "MisterALG: interpretador, editor e depurador de Portugol para Windows, macOS e Linux, inspirado no VisuAlg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victinjr199xs-cyber/MisterALG.git"
  },
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "npm run dev -w misteralg-app",
    "build": "npm run build -w misteralg-app",
    "test": "npm run test:codificacao && npm run test:interpreter && npm run test:busca && npm run test:app && npm run test:interpretador-c && npm run test:compat && npm run test:interpretador-js && npm run test:interpretador-python",
    "test:app": "node --test app/src/compartilhado/ia.test.mjs app/src/main/compilador.test.mjs",
    "test:interpretador-c": "npm run test -w @misteralg/interpretador-c",
    "test:interpretador-js": "npm run test -w @misteralg/interpretador-js",
    "test:interpretador-python": "npm run test -w @misteralg/interpretador-python",
    "test:codificacao": "node scripts/verificar-codificacao.mjs",
    "test:interpreter": "npm run test -w @misteralg/interpreter",
    "test:busca": "npm run test -w @misteralg/editor-busca",
    "test:compat": "node --test testes-compat/p0.test.mjs testes-compat/exemplos.test.mjs",
    "test:compat:full": "node --test \"testes-compat/*.test.mjs\"",
    "dist:mac": "npm run build && npm run dist:mac -w misteralg-app",
    "dist:win": "npm run build && npm run dist:win -w misteralg-app",
    "dist:linux": "npm run build && npm run dist:linux -w misteralg-app"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "allowScripts": {
    "electron@44.8.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.1.4"
  }
}
